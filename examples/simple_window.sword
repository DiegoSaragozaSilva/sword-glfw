import "../glfw"

func main() int {
    mut window glfw.Window = nil 
    if !glfw.Init() {
        return -1
    }

    window = glfw.CreateWindow(640, 480, "Hello, World!", nil, nil)
    if window == nil {
        glfw.Terminate()
        return -1
    }

    glfw.MakeContextCurrent(window)

    for {
        if glfw.WindowShouldClose(window) {
            break
        }

        glfw.SwapBuffers(window)
        glfw.PollEvents()
    }

    glfw.Terminate()
    return 0
}
